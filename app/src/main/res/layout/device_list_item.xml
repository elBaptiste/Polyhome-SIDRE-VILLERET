<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/idDeviceListItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="ID"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="22dp" />

    <TextView
        android:id="@+id/typeDeviceListItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Type"
        app:layout_constraintStart_toStartOf="@+id/idDeviceListItem"
        app:layout_constraintTop_toBottomOf="@+id/idDeviceListItem" />

    <TextView
        android:id="@+id/availableCommandsDeviceListItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="available commands"
        app:layout_constraintStart_toStartOf="@+id/typeDeviceListItem"
        app:layout_constraintTop_toBottomOf="@+id/typeDeviceListItem" />
</androidx.constraintlayout.widget.ConstraintLayout>